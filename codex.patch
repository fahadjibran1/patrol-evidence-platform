+  @Get()
+  async findBySiteAndDate(
+    @Query('siteCode') siteCode: string,
+    @Query('date') date: string,
+  ): Promise<PatrolSlot[]> {
+    if (!siteCode || !date) {
+      throw new BadRequestException('siteCode and date query params are required');
+    }
