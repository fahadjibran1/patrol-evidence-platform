NODE_ENV=development
PORT=3000
APP_TIMEZONE=Europe/London
WHATSAPP_ENABLED=false
WHATSAPP_AUTO_START=false
WHATSAPP_HEADLESS=true
WHATSAPP_ALLOW_FROM_ME=false
WHATSAPP_BACKFILL_MESSAGE_LIMIT=150
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_PILOT_GROUP_NAME=
WHATSAPP_PILOT_SITE_CODE=
# Force browser: chrome | edge | auto
WHATSAPP_BROWSER=auto
# WHATSAPP_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# WhatsApp Web HTML: pinned (local cache) or live (current WA Web via whatsapp-web.js; no silent fallback)
PATROL_WHATSAPP_WEB_VERSION_MODE=live
# PATROL_WHATSAPP_WEB_VERSION=2.3000.1040111714-alpha
# PATROL_WHATSAPP_WEB_VERSION_CACHE_PATH=DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=patrol_evidence
STORAGE_ROOT_PATH=./Security_Patrols
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_HOURS=12
