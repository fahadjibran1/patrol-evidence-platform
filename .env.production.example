# Production environment template — copy to .env.production on the host (never commit secrets).
NODE_ENV=production
APP_VERSION=1.0.0
BUILD_NUMBER=
BUILD_TIMESTAMP=
GIT_COMMIT=
ERROR_REPORTING_PROVIDER=console
# Future: sentry | azure-monitor | datadog

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=patrol_license_portal
LICENSE_DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/patrol_license_portal?schema=public
REDIS_URL=redis://redis:6379

PORT=3010
LICENSE_PORTAL_ORIGIN=https://admin.example.com
CUSTOMER_PORTAL_ORIGIN=https://portal.example.com

# Required — startup fails without these
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CUSTOMER_JWT_ACCESS_EXPIRES_IN=15m
CUSTOMER_JWT_REFRESH_EXPIRES_IN=7d
CUSTOMER_JWT_REMEMBER_EXPIRES_IN=30d
LICENCE_STORAGE_ENCRYPTION_KEY=
LICENSE_SIGNING_KEY_ID=
LICENSE_PRIVATE_KEY=
# Or: LICENSE_PRIVATE_KEY_FILE=/run/secrets/license_private.pem

# Strongly recommended in production (startup warns if missing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_NAME=Patrol Licence Portal
SMTP_FROM_EMAIL=licences@example.com

LICENSE_API_ENABLE_SWAGGER=false
ADMIN_PORTAL_VERSION=1.0.0
CUSTOMER_PORTAL_VERSION=1.0.0
DESKTOP_VERSION=1.0.0

# Stripe (set STRIPE_ENABLED=true only when live/test secrets are fully configured)
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2024-11-20.acacia
# STRIPE_CHECKOUT_SUCCESS_URL=https://portal.example.com/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=https://portal.example.com/billing/checkout/cancelled
# STRIPE_BILLING_PORTAL_RETURN_URL=https://portal.example.com/billing
# BILLING_GRACE_PERIOD_DAYS=7
# BILLING_TERMS_VERSION=2026-07-01
# STRIPE_WEBHOOK_MAX_ATTEMPTS=8
# STRIPE_ADMIN_ALERT_EMAIL=
