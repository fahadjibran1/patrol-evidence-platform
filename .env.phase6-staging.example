# PatrolSafe v1.0.3 Phase 6 staging only. Never use this file for production.
NODE_ENV=staging
PATROLSAFE_COMMERCIAL_STAGING=true

# Desktop: fixed, allowlisted staging origins and the public half of the test key only.
PATROLSAFE_COMMERCIAL_SERVICE_ORIGIN=https://licensing-staging.sfour.co.uk/
PATROLSAFE_COMMERCIAL_PURCHASE_ORIGIN=https://staging.sfour.co.uk/
LICENSE_ONLINE_PUBLIC_KEY_ID=test-phase6-online-key
LICENSE_ONLINE_PUBLIC_KEY_FILE=C:\external-staging-secrets\phase6-online-public.pem

# Customer staging page. The live v1.0.2 acquisition remains independent.
VITE_COMMERCIAL_STAGING_ENABLED=true
VITE_LICENSE_API_URL=https://licensing-staging.sfour.co.uk

# Licence API: values marked EXTERNAL must be injected by the staging secret store.
LICENSE_DATABASE_URL=<EXTERNAL_STAGING_POSTGRES_URL>
COMMERCIAL_OUTBOX_WORKER_ENABLED=true
COMMERCIAL_STRIPE_ENABLED=true
COMMERCIAL_STRIPE_SECRET_KEY=<EXTERNAL_STRIPE_TEST_SECRET>
COMMERCIAL_STRIPE_WEBHOOK_SECRET=<EXTERNAL_STRIPE_TEST_WEBHOOK_SECRET>
COMMERCIAL_CHECKOUT_SUCCESS_URL=https://staging.sfour.co.uk/patrolsafe/licence/status/{ORDER_REFERENCE}?checkout=success
COMMERCIAL_CHECKOUT_CANCEL_URL=https://staging.sfour.co.uk/patrolsafe/licence/status/{ORDER_REFERENCE}?checkout=cancelled
COMMERCIAL_TERMS_VERSION=<APPROVED_STAGING_TERMS_VERSION>
COMMERCIAL_PRIVACY_VERSION=<APPROVED_STAGING_PRIVACY_VERSION>

# Test issuer: the private key and artifacts remain outside the repository.
COMMERCIAL_TEST_ISSUER_ENABLED=true
COMMERCIAL_TEST_SIGNING_KEY_ID=test-phase6-online-key
COMMERCIAL_TEST_SIGNING_PRIVATE_KEY_FILE=C:\external-staging-secrets\UNMISTAKABLY-TEST-ONLY-ed25519-private.pem
COMMERCIAL_TEST_ARTIFACT_ROOT=C:\external-staging-data\private-licence-artifacts

# Delivery: secrets are staging-only and externally injected.
COMMERCIAL_DELIVERY_TOKEN_SECRET=<EXTERNAL_32_BYTE_OR_LONGER_SECRET>
COMMERCIAL_LICENCE_DOWNLOAD_BASE_URL=https://licensing-staging.sfour.co.uk/commercial/licence/download
COMMERCIAL_RESEND_ENABLED=true
COMMERCIAL_RESEND_API_KEY=<EXTERNAL_RESEND_TEST_KEY>
COMMERCIAL_RESEND_FROM=PatrolSafe Staging <staging-licensing@staging.sfour.co.uk>
COMMERCIAL_RESEND_WEBHOOK_SECRET=<EXTERNAL_RESEND_TEST_WEBHOOK_SECRET>
