NODE_ENV=development
LICENSE_API_PORT=3010
LICENSE_PORTAL_ORIGIN=http://localhost:5174
CUSTOMER_PORTAL_ORIGIN=http://localhost:5175

# PostgreSQL connection for licence administration data
LICENSE_DATABASE_URL=postgresql://patrol_license:patrol_license_dev@localhost:5433/patrol_license_portal?schema=public

# Optional dedicated database for integration tests (defaults to LICENSE_DATABASE_URL or DB_* + patrol_license_portal_test)
# LICENSE_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/patrol_license_portal_test?schema=public
# LICENSE_TEST_DATABASE_NAME=patrol_license_portal_test

# JWT (access 15m, refresh 7d — configured in auth module)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key for encrypting stored TG1 keys (64 hex chars = 32 bytes)
LICENCE_STORAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ed25519 signing key — supply inline PEM or file path (never commit real keys)
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_PRIVATE_KEY_FILE=../../.license-keys/license-private.pem
LICENSE_SIGNING_KEY_ID=primary-2026

# Initial SUPER_ADMIN (used by npm run admin:create)
# LICENSE_ADMIN_EMAIL=admin@example.com
# LICENSE_ADMIN_PASSWORD=change-me
# LICENSE_ADMIN_DISPLAY_NAME=Platform Admin

# SMTP (optional until notifications are used — missing config returns a clean send error)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_FROM_NAME=Patrol Licence Portal
# SMTP_FROM_EMAIL=licences@example.com

# Redis / BullMQ (optional — when unset, email jobs run inline/in-process; set for production durability)
# REDIS_URL=redis://localhost:6379

# Observability / health (optional)
# APP_VERSION=1.0.0
# BUILD_NUMBER=local
# BUILD_TIMESTAMP=
# GIT_COMMIT=
# ADMIN_PORTAL_VERSION=0.1.0
# CUSTOMER_PORTAL_VERSION=0.1.0
# DESKTOP_VERSION=1.0.0
# ERROR_REPORTING_PROVIDER=console
# LICENSE_API_ENABLE_SWAGGER=false

# Stripe (optional — disabled when STRIPE_ENABLED is unset/false)
# Never commit real secrets. Use Stripe CLI for local webhook forwarding.
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2024-11-20.acacia
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5175/billing/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5175/billing/checkout/cancelled
# STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5175/billing
# BILLING_GRACE_PERIOD_DAYS=7
# BILLING_TERMS_VERSION=2026-07-01
# STRIPE_WEBHOOK_MAX_ATTEMPTS=8
# STRIPE_ADMIN_ALERT_EMAIL=ops@example.com

# PatrolSafe v1.0.3 commercial Phase 2 (TEST MODE ONLY)
# Product, plan, amount (29900) and GBP currency are server-owned in code.
# COMMERCIAL_STRIPE_ENABLED=false
# COMMERCIAL_STRIPE_SECRET_KEY=sk_test_...
# COMMERCIAL_STRIPE_WEBHOOK_SECRET=whsec_...
# COMMERCIAL_STRIPE_API_VERSION=2024-11-20.acacia
# COMMERCIAL_CHECKOUT_SUCCESS_URL=https://test.sfour.co.uk/patrolsafe/licence/status/{ORDER_REFERENCE}?checkout=success
# COMMERCIAL_CHECKOUT_CANCEL_URL=https://test.sfour.co.uk/patrolsafe/licence/status/{ORDER_REFERENCE}?checkout=cancelled
# COMMERCIAL_TERMS_VERSION=pending-commercial-approval
# COMMERCIAL_PRIVACY_VERSION=pending-commercial-approval
# COMMERCIAL_OUTBOX_WORKER_ENABLED=false
