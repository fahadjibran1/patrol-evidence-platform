generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LICENSE_DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum CustomerStatus {
  PROSPECT
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LicensePlan {
  TRIAL
  MONTHLY
  ANNUAL
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum InstallationStatus {
  PENDING
  ACTIVE
  DEACTIVATED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED
}

enum NotificationType {
  LICENSE_ISSUED
  LICENSE_REISSUED
  LICENSE_RENEWED
  LICENSE_EXPIRED
  LICENSE_EXPIRING
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  WELCOME
  PASSWORD_RESET
  ADMIN_ALERT
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  FAILED
}

enum NotificationProviderKind {
  EMAIL
}

enum CustomerRole {
  OWNER
  ADMINISTRATOR
  TECHNICAL
  FINANCE
  VIEWER
}

enum OrganisationInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum LicenceVersionAction {
  ISSUED
  RENEWED
  REISSUED
  PLAN_CHANGED
  DEVICE_LIMIT_CHANGED
  REACTIVATED
  SUSPENDED
  REVOKED
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  REFUNDED
  OVERDUE
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  STRIPE
  PAYPAL
  GOCARDLESS
}

enum StripeCheckoutSessionStatus {
  OPEN
  COMPLETE
  EXPIRED
}

enum StripeCheckoutPurpose {
  INITIAL
  RENEWAL
  UPGRADE
}

enum ScheduledPlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum StripeWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
  DEAD_LETTER
}

enum StripeReconciliationAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ManualPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum SupportLevel {
  STANDARD
  PRIORITY
  DEDICATED
}

enum CommercialPlan {
  ANNUAL
}

enum PurchaseRequestStatus {
  ACTIVE
  EXCHANGED
  EXPIRED
  CANCELLED
}

enum PurchaseReferenceStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum CommercialOrderPurpose {
  INITIAL
  RENEWAL
  REISSUE
}

enum CommercialOrderState {
  REQUEST_CREATED
  CHECKOUT_PENDING
  PAYMENT_PENDING
  PAID_AWAITING_APPROVAL
  ISSUANCE_PENDING
  ISSUED
  DELIVERY_PENDING
  DELIVERED
  FAILED
  HELD
  CANCELLED
  REJECTED
  REFUNDED
}

enum CommercialPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CommercialProvider {
  STRIPE
  MANUAL
  TEST
}

enum CommercialProviderMode {
  TEST
  LIVE
}

enum CommercialProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
  DEAD_LETTER
}

enum CommercialIssuanceType {
  INITIAL
  RENEWAL
  REISSUE
}

enum CommercialIssuanceStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  ISSUED
  FAILED
  HELD
}

enum CommercialArtifactStatus {
  PENDING
  AVAILABLE
  REVOKED
}

enum CommercialDeliveryStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  REVOKED
  EXPIRED
}

enum CommercialActorType {
  SYSTEM
  DESKTOP
  CUSTOMER
  OPERATOR
  PROVIDER
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  licencesCreated         Licence[]         @relation("LicenceCreatedBy")
  licencesSuspended       Licence[]         @relation("LicenceSuspendedBy")
  licencesRevoked         Licence[]         @relation("LicenceRevokedBy")
  licenceVersionsIssued   LicenceVersion[]  @relation("LicenceVersionIssuedBy")
  paymentsRecorded        PaymentRecord[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  notificationLogs        NotificationLog[]
  subscriptionsCreated    Subscription[]    @relation("SubscriptionCreatedBy")
  billingPaymentsRecorded BillingPayment[]  @relation("BillingPaymentRecordedBy")
  billingCreditsIssued    BillingCredit[]   @relation("BillingCreditIssuedBy")
  commercialStepUps       CommercialOperatorStepUp[]
  commercialApprovals     CommercialLicenceIssuance[] @relation("CommercialIssuanceApprovedBy")
}

/// One-time recent-password-verification credential for commercial approval actions.
/// Only a SHA-256 digest of the credential is persisted.
model CommercialOperatorStepUp {
  id         String   @id @default(uuid())
  adminId    String
  tokenHash  String   @unique
  purpose    String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, purpose, expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model Customer {
  id                    String         @id @default(uuid())
  companyName           String
  tradingName           String?
  contactName           String?
  email                 String
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  postcode              String?
  country               String         @default("GB")
  status                CustomerStatus @default(PROSPECT)
  notes                 String?
  technicalContactName  String?
  technicalContactEmail String?
  technicalContactPhone String?
  /// Organisation billing contact (defaults to primary email when null).
  billingEmail          String?
  /// Additional invoice recipient emails (JSON string array).
  invoiceRecipients     Json           @default("[]")
  /// When false, FINANCE role cannot purchase (Owner/Admin still can).
  allowFinancePurchases Boolean        @default(true)
  /// Tax / VAT identifier placeholder for future tax features.
  taxId                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  licences                   Licence[]
  payments                   PaymentRecord[]
  auditLogs                  AuditLog[]
  notificationLogs           NotificationLog[]
  users                      CustomerUser[]
  invitations                OrganisationInvitation[]
  subscriptions              Subscription[]
  billingCredits             BillingCredit[]
  stripeCustomerMappings     StripeCustomerMapping[]
  stripeCheckoutSessions     StripeCheckoutSession[]
  stripeReconciliationAlerts StripeReconciliationAlert[]
  commercialPurchaseRequests CommercialPurchaseRequest[]
  commercialOrders           CommercialOrder[]
  commercialIssuances        CommercialLicenceIssuance[]

  @@index([companyName])
  @@index([email])
}

/// Organisation member identity for a company (Customer). Distinct from Admin accounts.
model CustomerUser {
  id              String       @id @default(uuid())
  customerId      String
  email           String       @unique
  passwordHash    String
  displayName     String
  phone           String?
  role            CustomerRole @default(VIEWER)
  isActive        Boolean      @default(true)
  emailVerifiedAt DateTime?
  /// Reserved for future MFA — not enforced yet.
  mfaEnabled      Boolean      @default(false)
  mfaSecretEnc    String?
  notifyLicence   Boolean      @default(true)
  notifyGeneral   Boolean      @default(true)
  notifySystem    Boolean      @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  customer                Customer                         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions                CustomerSession[]
  refreshTokens           CustomerRefreshToken[]
  auditLogs               AuditLog[]
  invitationsSent         OrganisationInvitation[]         @relation("InvitationInvitedBy")
  passwordResetTokens     CustomerPasswordResetToken[]
  emailVerificationTokens CustomerEmailVerificationToken[]

  @@index([customerId])
  @@index([email])
  @@index([role])
}

model OrganisationInvitation {
  id              String                       @id @default(uuid())
  customerId      String
  email           String
  role            CustomerRole
  status          OrganisationInvitationStatus @default(PENDING)
  tokenHash       String                       @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  acceptedUserId  String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invitedBy CustomerUser @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id])

  @@index([customerId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model CustomerPasswordResetToken {
  id             String    @id @default(uuid())
  customerUserId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  customerUser CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId])
  @@index([expiresAt])
}

model CustomerEmailVerificationToken {
  id             String    @id @default(uuid())
  customerUserId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  customerUser CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)

  @@index([customerUserId])
  @@index([expiresAt])
}

model CustomerRefreshToken {
  id             String   @id @default(uuid())
  customerUserId String
  tokenHash      String   @unique
  expiresAt      DateTime
  rememberMe     Boolean  @default(false)
  createdAt      DateTime @default(now())

  customerUser CustomerUser     @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  session      CustomerSession?

  @@index([customerUserId])
}

/// Tracks an authenticated customer portal session (MFA-ready: extend with challenge state later).
model CustomerSession {
  id             String    @id @default(uuid())
  customerUserId String
  refreshTokenId String?   @unique
  ipAddress      String?
  userAgent      String?
  rememberMe     Boolean   @default(false)
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Reserved for future MFA step-up verification.
  mfaVerifiedAt  DateTime?
  createdAt      DateTime  @default(now())

  customerUser CustomerUser          @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  refreshToken CustomerRefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([customerUserId])
  @@index([expiresAt])
}

model LicenceIdSequence {
  year      Int @id
  lastValue Int @default(0)
}

model Licence {
  id                 String        @id @default(uuid())
  licenseId          String        @unique
  customerId         String
  plan               LicensePlan
  status             LicenseStatus @default(DRAFT)
  issuedAt           DateTime?
  startsAt           DateTime      @db.Date
  expiresAt          DateTime      @db.Date
  maxDevices         Int
  features           Json          @default("[]")
  notes              String?
  signedLicenseEnc   String?
  payloadHash        String?
  signingKeyId       String?
  previousLicenceId  String?
  currentVersionId   String?       @unique
  createdByAdminId   String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  suspendedAt        DateTime?
  suspendedByAdminId String?
  suspensionReason   String?
  revokedAt          DateTime?
  revokedByAdminId   String?
  revocationReason   String?
  downloadCount      Int           @default(0)
  lastDownloadedAt   DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  createdBy        Admin             @relation("LicenceCreatedBy", fields: [createdByAdminId], references: [id])
  suspendedBy      Admin?            @relation("LicenceSuspendedBy", fields: [suspendedByAdminId], references: [id])
  revokedBy        Admin?            @relation("LicenceRevokedBy", fields: [revokedByAdminId], references: [id])
  previousLicence  Licence?          @relation("LicenceRenewalChain", fields: [previousLicenceId], references: [id])
  renewals         Licence[]         @relation("LicenceRenewalChain")
  currentVersion   LicenceVersion?   @relation("LicenceCurrentVersion", fields: [currentVersionId], references: [id])
  versions         LicenceVersion[]  @relation("LicenceVersions")
  installations    Installation[]
  payments         PaymentRecord[]
  auditLogs        AuditLog[]
  notificationLogs NotificationLog[]

  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model LicenceVersion {
  id                String               @id @default(uuid())
  licenceId         String
  versionNumber     Int
  actionType        LicenceVersionAction
  plan              LicensePlan
  maxDevices        Int
  features          Json                 @default("[]")
  validFrom         DateTime             @db.Date
  validUntil        DateTime             @db.Date
  statusSnapshot    LicenseStatus
  signedLicenseEnc  String?
  payloadHash       String?
  signingKeyId      String?
  issuedByAdminId   String
  previousVersionId String?
  reason            String?
  metadata          Json?
  createdAt         DateTime             @default(now())

  licence           Licence          @relation("LicenceVersions", fields: [licenceId], references: [id], onDelete: Cascade)
  issuedBy          Admin            @relation("LicenceVersionIssuedBy", fields: [issuedByAdminId], references: [id])
  previousVersion   LicenceVersion?  @relation("LicenceVersionChain", fields: [previousVersionId], references: [id])
  nextVersions      LicenceVersion[] @relation("LicenceVersionChain")
  currentForLicence Licence?         @relation("LicenceCurrentVersion")

  @@unique([licenceId, versionNumber])
  @@index([licenceId, versionNumber])
  @@index([statusSnapshot])
  @@index([validUntil])
  @@index([createdAt])
  @@index([actionType])
}

model Installation {
  id                 String             @id @default(uuid())
  licenceId          String
  installationId     String
  deviceLabel        String?
  customerProvidedAt DateTime?
  firstSeenAt        DateTime?
  lastSeenAt         DateTime?
  status             InstallationStatus @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  licence Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)

  @@unique([licenceId, installationId])
  @@index([installationId])
}

model PaymentRecord {
  id                String        @id @default(uuid())
  customerId        String
  licenceId         String?
  amountPence       Int
  currency          String        @default("GBP")
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     String?
  paymentReference  String?
  invoiceReference  String?
  paidAt            DateTime?
  periodStart       DateTime?     @db.Date
  periodEnd         DateTime?     @db.Date
  notes             String?
  recordedByAdminId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  licence    Licence? @relation(fields: [licenceId], references: [id])
  recordedBy Admin    @relation(fields: [recordedByAdminId], references: [id])

  @@index([customerId])
  @@index([licenceId])
  @@index([paymentStatus])
}

model AuditLog {
  id                  String               @id @default(uuid())
  actorAdminId        String?
  actorCustomerUserId String?
  actorId             String?
  action              String
  entityType          String
  entityId            String?
  customerId          String?
  licenceId           String?
  metadata            Json?
  ipAddress           String?
  userAgent           String?
  actorType           CommercialActorType?
  correlationId       String?
  createdAt           DateTime             @default(now())

  actor             Admin?        @relation(fields: [actorAdminId], references: [id])
  actorCustomerUser CustomerUser? @relation(fields: [actorCustomerUserId], references: [id])
  customer          Customer?     @relation(fields: [customerId], references: [id])
  licence           Licence?      @relation(fields: [licenceId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([customerId])
  @@index([licenceId])
  @@index([actorCustomerUserId])
  @@index([actorType, actorId])
  @@index([correlationId])
}

model NotificationLog {
  id               String                   @id @default(uuid())
  notificationType NotificationType
  provider         NotificationProviderKind
  recipient        String
  subject          String
  status           NotificationStatus       @default(PENDING)
  attempts         Int                      @default(0)
  sentAt           DateTime?
  errorMessage     String?
  metadata         Json?
  source           String?
  licenceId        String?
  customerId       String?
  actorAdminId     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  licence    Licence?  @relation(fields: [licenceId], references: [id], onDelete: SetNull)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  actorAdmin Admin?    @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([notificationType])
  @@index([status])
  @@index([recipient])
  @@index([createdAt])
  @@index([licenceId])
  @@index([customerId])
  @@index([actorAdminId])
}

/// Commercial plan catalogue — source of truth for pricing and entitlements.
model Plan {
  id               String          @id @default(uuid())
  code             String          @unique
  name             String
  description      String?
  status           PlanStatus      @default(DRAFT)
  /// Minor currency units (e.g. pence).
  monthlyPrice     Int
  /// Minor currency units (e.g. pence).
  annualPrice      Int
  currency         String          @default("GBP")
  billingInterval  BillingInterval @default(MONTHLY)
  trialDays        Int             @default(0)
  maxDevices       Int             @default(1)
  /// Application feature codes (see BillingFeature).
  includedFeatures Json            @default("[]")
  supportLevel     SupportLevel    @default(STANDARD)
  sortOrder        Int             @default(100)
  isPublic         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subscriptions        Subscription[]       @relation("SubscriptionCurrentPlan")
  pendingSubscriptions Subscription[]       @relation("SubscriptionPendingPlan")
  stripePriceMappings  StripePriceMapping[]

  @@index([status])
  @@index([isPublic])
  @@index([sortOrder])
}

model Subscription {
  id                      String                   @id @default(uuid())
  organisationId          String
  planId                  String
  status                  SubscriptionStatus       @default(TRIAL)
  billingInterval         BillingInterval
  startedAt               DateTime?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  nextBillingDate         DateTime?
  autoRenew               Boolean                  @default(true)
  trialEndsAt             DateTime?
  cancelAtPeriodEnd       Boolean                  @default(false)
  cancelledAt             DateTime?
  cancellationReason      String?
  /// Pending purchase awaiting Stripe Checkout confirmation (not yet ACTIVE).
  pendingCheckout         Boolean                  @default(false)
  /// Scheduled/in-flight plan change (upgrade pending payment or downgrade at period end).
  pendingPlanId           String?
  pendingBillingInterval  BillingInterval?
  planChangeEffectiveAt   DateTime?
  scheduledChangeType     ScheduledPlanChangeType?
  /// Admin override for grace period days (null = use BILLING_GRACE_PERIOD_DAYS).
  gracePeriodDaysOverride Int?
  createdByAdminId        String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  organisation              Customer                   @relation(fields: [organisationId], references: [id])
  plan                      Plan                       @relation("SubscriptionCurrentPlan", fields: [planId], references: [id])
  pendingPlan               Plan?                      @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  createdBy                 Admin?                     @relation("SubscriptionCreatedBy", fields: [createdByAdminId], references: [id])
  invoices                  Invoice[]
  billingCredits            BillingCredit[]
  stripeSubscriptionMapping StripeSubscriptionMapping?
  stripeCheckoutSessions    StripeCheckoutSession[]

  @@index([organisationId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([currentPeriodEnd])
  @@index([pendingCheckout])
  @@index([pendingPlanId])
  @@index([planChangeEffectiveAt])
}

model BillingCredit {
  id              String   @id @default(uuid())
  organisationId  String
  subscriptionId  String?
  /// Minor currency units (positive credit).
  amount          Int
  currency        String   @default("GBP")
  reason          String
  issuedByAdminId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Customer      @relation(fields: [organisationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  issuedBy     Admin?        @relation("BillingCreditIssuedBy", fields: [issuedByAdminId], references: [id])

  @@index([organisationId])
  @@index([subscriptionId])
}

model InvoiceNumberSequence {
  year      Int @id
  lastValue Int @default(0)
}

model Invoice {
  id             String        @id @default(uuid())
  subscriptionId String
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  /// Minor currency units.
  subtotal       Int
  tax            Int           @default(0)
  discount       Int           @default(0)
  total          Int
  currency       String        @default("GBP")
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription     @relation(fields: [subscriptionId], references: [id])
  payments     BillingPayment[]

  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@index([issuedAt])
}

/// Provider-agnostic payment against an invoice. MANUAL + STRIPE in Phase 5A.
model BillingPayment {
  id                String               @id @default(uuid())
  invoiceId         String
  provider          PaymentProvider      @default(MANUAL)
  providerReference String?
  status            BillingPaymentStatus @default(PENDING)
  amount            Int
  currency          String               @default("GBP")
  manualMethod      ManualPaymentMethod?
  notes             String?
  receivedAt        DateTime?
  recordedByAdminId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy Admin?  @relation("BillingPaymentRecordedBy", fields: [recordedByAdminId], references: [id])

  @@unique([provider, providerReference])
  @@index([invoiceId])
  @@index([status])
  @@index([provider])
  @@index([receivedAt])
}

model StripeCustomerMapping {
  id               String   @id @default(uuid())
  organisationId   String
  stripeCustomerId String   @unique
  livemode         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organisation Customer @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, livemode])
  @@index([organisationId])
}

model StripePriceMapping {
  id              String          @id @default(uuid())
  planId          String
  billingInterval BillingInterval
  stripeProductId String
  stripePriceId   String          @unique
  currency        String
  active          Boolean         @default(true)
  livemode        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, billingInterval, livemode])
  @@index([planId])
  @@index([active])
}

model StripeSubscriptionMapping {
  id                    String   @id @default(uuid())
  subscriptionId        String   @unique
  stripeSubscriptionId  String   @unique
  stripeCustomerId      String
  latestStripeInvoiceId String?
  livemode              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([stripeCustomerId])
}

model StripeCheckoutSession {
  id                      String                      @id @default(uuid())
  organisationId          String
  internalSubscriptionId  String?
  internalInvoiceId       String?
  stripeCheckoutSessionId String                      @unique
  purpose                 StripeCheckoutPurpose       @default(INITIAL)
  status                  StripeCheckoutSessionStatus @default(OPEN)
  expiresAt               DateTime?
  completedAt             DateTime?
  livemode                Boolean                     @default(false)
  acceptedTermsVersion    String?
  idempotencyKey          String                      @unique
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  organisation Customer      @relation(fields: [organisationId], references: [id])
  subscription Subscription? @relation(fields: [internalSubscriptionId], references: [id])

  @@index([organisationId])
  @@index([status])
  @@index([purpose])
  @@index([internalSubscriptionId])
}

model StripeWebhookEvent {
  id               String                        @id @default(uuid())
  stripeEventId    String                        @unique
  type             String
  apiVersion       String?
  livemode         Boolean                       @default(false)
  processingStatus StripeWebhookProcessingStatus @default(RECEIVED)
  attempts         Int                           @default(0)
  receivedAt       DateTime                      @default(now())
  processedAt      DateTime?
  lastError        String?
  payloadHash      String
  /// Minimal metadata JSON (object ids / type) — never full card data.
  metadata         Json                          @default("{}")
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  @@index([processingStatus])
  @@index([type])
  @@index([receivedAt])
}

model StripeReconciliationAlert {
  id             String                          @id @default(uuid())
  organisationId String?
  alertType      String
  message        String
  status         StripeReconciliationAlertStatus @default(OPEN)
  stripeObjectId String?
  internalRef    String?
  metadata       Json                            @default("{}")
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  resolvedAt     DateTime?

  organisation Customer? @relation(fields: [organisationId], references: [id])

  @@index([status])
  @@index([organisationId])
  @@index([alertType])
}

/// Canonical, untrusted desktop purchase request after strict server validation.
model CommercialPurchaseRequest {
  id                     String                @id @default(uuid())
  requestId              String                @unique
  schemaVersion          Int
  product                String
  plan                   CommercialPlan
  installationId         String
  machineFingerprintEnc  String
  machineFingerprintHash String
  companyName            String
  appVersion             String
  buildId                String
  clientNonceHash        String                @unique
  previousLicenceId      String?
  canonicalRequestHash   String                @unique
  status                 PurchaseRequestStatus @default(ACTIVE)
  customerId             String?
  createdAt              DateTime              @default(now())
  expiresAt              DateTime
  exchangedAt            DateTime?
  cancelledAt            DateTime?

  customer   Customer?                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  references CommercialPurchaseReference[]
  orders     CommercialOrder[]

  @@index([installationId])
  @@index([machineFingerprintHash])
  @@index([status, expiresAt])
  @@index([customerId])
}

/// One-time bearer reference. Only a SHA-256 digest is persisted.
model CommercialPurchaseReference {
  id                String                  @id @default(uuid())
  purchaseRequestId String
  referenceHash     String                  @unique
  scope             String
  status            PurchaseReferenceStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?
  revokedAt         DateTime?
  exchangeCount     Int                     @default(0)

  purchaseRequest CommercialPurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@index([purchaseRequestId])
  @@index([status, expiresAt])
}

/// Immutable commercial agreement snapshot. Server-owned price/provider fields are populated at Checkout.
model CommercialOrder {
  id                        String                  @id @default(uuid())
  publicOrderId             String                  @unique
  purchaseRequestId         String
  requestHashSnapshot       String
  customerId                String?
  purpose                   CommercialOrderPurpose  @default(INITIAL)
  state                     CommercialOrderState    @default(REQUEST_CREATED)
  stateVersion              Int                     @default(0)
  failedFromState           CommercialOrderState?
  heldFromState             CommercialOrderState?
  product                   String
  plan                      CommercialPlan
  amountMinor               Int?
  currency                  String?
  taxPolicy                 String?
  termsVersion              String?
  privacyVersion            String?
  providerCheckoutSessionId String?                 @unique
  providerPaymentIntentId   String?                 @unique
  providerCustomerId        String?
  providerMode              CommercialProviderMode?
  checkoutStatus            String?
  checkoutExpiresAt         DateTime?
  checkoutGeneration        Int                     @default(0)
  failureCode               String?
  failureMessage            String?
  holdReason                String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  cancelledAt               DateTime?
  refundedAt                DateTime?

  purchaseRequest  CommercialPurchaseRequest   @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  customer         Customer?                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments         CommercialPayment[]
  checkoutSessions CommercialCheckoutSession[]
  issuance         CommercialLicenceIssuance?

  @@unique([purchaseRequestId, purpose])
  @@index([customerId])
  @@index([state])
  @@index([createdAt])
}

model CommercialCheckoutSession {
  id                      String                 @id @default(uuid())
  orderId                 String
  provider                CommercialProvider
  providerMode            CommercialProviderMode
  providerSessionId       String                 @unique
  providerCustomerId      String?
  providerPaymentIntentId String?
  generation              Int
  status                  String
  isActive                Boolean                @default(true)
  amountMinor             Int
  currency                String
  expiresAt               DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  closedAt                DateTime?

  order CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, generation])
  @@index([orderId, isActive])
  @@index([providerPaymentIntentId])
}

model CommercialPayment {
  id                 String                  @id @default(uuid())
  orderId            String
  provider           CommercialProvider
  providerReference  String
  providerMode       CommercialProviderMode
  checkoutSessionId  String?
  providerCustomerId String?
  status             CommercialPaymentStatus @default(PENDING)
  amountMinor        Int
  taxMinor           Int                     @default(0)
  currency           String
  paidAt             DateTime?
  refundedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  order CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@unique([provider, checkoutSessionId])
  @@index([orderId])
  @@index([status])
}

model CommercialProviderEvent {
  id                String                        @id @default(uuid())
  provider          CommercialProvider
  providerEventId   String
  eventType         String
  payloadHash       String
  status            CommercialProviderEventStatus @default(RECEIVED)
  attempts          Int                           @default(0)
  safeMetadata      Json                          @default("{}")
  receivedAt        DateTime                      @default(now())
  processedAt       DateTime?
  lastError         String?
  correlationId     String?
  providerCreatedAt DateTime?
  livemode          Boolean                       @default(false)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([provider, providerEventId])
  @@index([status])
  @@index([correlationId])
}

model CommercialLicenceIssuance {
  id                   String                   @id @default(uuid())
  orderId              String                   @unique
  customerId           String?
  issuanceType         CommercialIssuanceType
  status               CommercialIssuanceStatus @default(PENDING_APPROVAL)
  licenceId            String?                  @unique
  predecessorLicenceId String?
  reissueReason        String?
  requestHash          String
  payloadHash          String?
  signingKeyId         String?
  startsAt             DateTime?                @db.Date
  expiresAt            DateTime?                @db.Date
  issuedAt             DateTime?
  featuresSnapshot     Json?
  maxDevices           Int?
  approvedByAdminId    String?
  approvedAt           DateTime?
  commercialReviewRequired Boolean              @default(false)
  postIssuanceRefundAt DateTime?
  failureCode          String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  order     CommercialOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  Customer?                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  approvedBy Admin?                     @relation("CommercialIssuanceApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  artifacts CommercialLicenceArtifact[]

  @@index([customerId])
  @@index([status])
  @@index([predecessorLicenceId])
}

model CommercialLicenceArtifact {
  id          String                   @id @default(uuid())
  artifactId  String                   @unique
  issuanceId  String                   @unique
  status      CommercialArtifactStatus @default(PENDING)
  fileName    String
  storageKey  String                   @unique
  sha256      String
  byteSize    BigInt
  contentType String
  createdAt   DateTime                 @default(now())
  availableAt DateTime?
  revokedAt   DateTime?

  issuance         CommercialLicenceIssuance   @relation(fields: [issuanceId], references: [id], onDelete: Restrict)
  deliveryAttempts CommercialDeliveryAttempt[]

  @@index([status])
  @@index([sha256])
}

model CommercialDeliveryAttempt {
  id                String                   @id @default(uuid())
  artifactId        String
  idempotencyKey    String                   @unique
  status            CommercialDeliveryStatus @default(PENDING)
  channel           String
  recipient         String
  tokenHash         String?                  @unique
  tokenExpiresAt    DateTime?
  providerMessageId String?                  @unique
  attempts          Int                      @default(0)
  lastError         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  sentAt            DateTime?
  deliveredAt       DateTime?
  revokedAt         DateTime?

  artifact CommercialLicenceArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@index([artifactId])
  @@index([status])
}

model CommercialOutboxEvent {
  id             String            @id @default(uuid())
  eventId        String            @unique
  idempotencyKey String            @unique
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  publishedAt    DateTime?
  lastError      String?
  correlationId  String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
}
