{
  "name": "patrol-evidence-platform",
  "productName": "Patrol Evidence Platform",
  "displayName": "PatrolSafe by S4",
  "brandName": "PatrolSafe",
  "endorsement": "by S4",
  "tagline": "Patrol evidence. Automatically organised.",
  "version": "1.0.2",
  "buildId": "2026.09.18.15.37.30",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "web"
  ],
  "description": "Patrol evidence. Automatically organised.",
  "author": "Vesoft Services Limited",
  "companyName": "Vesoft Services Limited",
  "copyright": "© 2026 Vesoft Services Limited. All rights reserved.",
  "windowsIconUrl": "https://raw.githubusercontent.com/fahadjibran1/patrol-evidence-platform/main/desktop/assets/patrolsafe.ico",
  "generalEmail": "hello@sfour.co.uk",
  "supportEmail": "support@sfour.co.uk",
  "securityEmail": "security@sfour.co.uk",
  "legalEmail": "legal@sfour.co.uk",
  "privacyEmail": "privacy@sfour.co.uk",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.22.0 <22.23.0"
  },
  "scripts": {
    "build": "npm --prefix packages/license-core run build && nest build && node scripts/assert-backend-dist.js",
    "frontend:build": "npm --prefix web run build",
    "frontend:dev": "npm --prefix web run dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "postinstall": "node scripts/postinstall-native.js && npx patch-package",
    "collector:compat-matrix": "node scripts/whatsapp-wwebjs-compat-matrix.js",
    "rebuild:native": "node scripts/rebuild-native.js",
    "desktop:clean": "node scripts/clean-desktop-build.js",
    "desktop:dev": "concurrently -k \"npm run frontend:dev\" \"wait-on http://localhost:5173 && cross-env DESKTOP_DEV=true electron .\"",
    "desktop:rebuild-native": "npm run rebuild:native",
    "desktop:package:internal": "npm run desktop:verify-license-public-key-build && npm run desktop:clean && node scripts/generate-build-metadata.js && npm run build && npm run frontend:build && npm run desktop:rebuild-native && electron-forge package && npm run desktop:verify-electron-runtime && npm run desktop:verify-license-public-key-packaged && npm run desktop:verify-package",
    "desktop:make:internal": "npm run desktop:verify-license-public-key-build && npm run desktop:clean && node scripts/generate-build-metadata.js && npm run build && npm run frontend:build && npm run desktop:rebuild-native && electron-forge make && npm run desktop:verify-electron-runtime && npm run desktop:verify-license-public-key-packaged && npm run desktop:verify-package",
    "licence:generate": "node tools/licence-generator/generate-licence.js",
    "licence:reset-trial:dev": "node scripts/reset-local-trial-dev.js",
    "desktop:package": "node scripts/run-desktop-forge.js package",
    "desktop:make": "node scripts/run-desktop-forge.js make",
    "desktop:portable": "npm run desktop:package && node scripts/create-portable-zip.js",
    "desktop:verify-package": "node scripts/verify-packaged-app.js",
    "desktop:verify-license-public-key-build": "node scripts/verify-license-public-key-build.js",
    "desktop:verify-license-public-key-packaged": "node scripts/verify-license-public-key-packaged.js",
    "desktop:verify-electron-runtime": "node scripts/verify-electron-runtime-files.js",
    "desktop:verify-first-run-config": "node scripts/verify-desktop-first-run-config.js",
    "release:windows": "node scripts/run-release-windows.js",
    "release:windows:signed-rc": "node scripts/build-signed-windows-rc.js",
    "desktop:ensure-electron-runtime": "node scripts/ensure-electron-runtime-files.js",
    "desktop:smoke-backend": "node scripts/smoke-packaged-backend.js",
    "desktop:smoke-first-run": "node scripts/smoke-packaged-first-run.js",
    "desktop:smoke-first-run-ui": "node scripts/smoke-packaged-first-run-ui.js",
    "desktop:smoke-whatsapp": "node scripts/smoke-packaged-whatsapp.js",
    "collector:smoke": "node scripts/smoke-collector-helper.js",
    "collector:smoke-chat-discovery": "node scripts/smoke-collector-chat-discovery.js",
    "collector:smoke-post-auth": "node scripts/smoke-collector-post-auth.js",
    "collector:probe-ready": "node scripts/probe-whatsapp-auth-ready-lifecycle.js",
    "collector:simulate-live-image": "node scripts/simulate-whatsapp-live-image.js",
    "collector:live-debug": "node scripts/collector-live-debug.js",
    "test:wa-raw-capture": "node scripts/wa-raw-image-capture-test.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "repair:patrol-timezone": "npx ts-node -r tsconfig-paths/register scripts/repair-patrol-timezone.ts",
    "license:generate-trial": "npx ts-node -r tsconfig-paths/register scripts/generate-trial-key.ts",
    "license:generate": "npx ts-node -r tsconfig-paths/register scripts/generate-license.ts",
    "license:generate-keypair": "npx ts-node scripts/generate-license-keypair.ts",
    "license-portal:dev": "concurrently -k \"npm run license-api:dev\" \"npm run license-portal:web:dev\"",
    "license-portal:build": "npm run license-api:build && npm run license-portal:web:build",
    "license-api:dev": "npm run start:dev --workspace @patrol/license-api",
    "license-api:build": "npm run build --workspace @patrol/license-api",
    "license-portal:web:dev": "npm run dev --workspace @patrol/license-portal",
    "license-portal:web:build": "npm run build --workspace @patrol/license-portal",
    "customer-portal:dev": "npm run dev --workspace @patrol/customer-portal",
    "customer-portal:build": "npm run build --workspace @patrol/customer-portal",
    "customer-portal:test": "npm test --workspace @patrol/customer-portal",
    "license-db:migrate": "npm run db:migrate --workspace @patrol/license-api",
    "license-db:seed": "npm run db:seed --workspace @patrol/license-api",
    "license-admin:create": "npm run admin:create --workspace @patrol/license-api",
    "license-customer-user:create": "npm run customer-user:create --workspace @patrol/license-api",
    "license-api:test:integration": "npm run test:integration --workspace @patrol/license-api",
    "license-api:worker": "npm run start:worker --workspace @patrol/license-api",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:staging": "docker compose -f docker-compose.staging.yml up -d --build",
    "docker:production": "docker compose -f docker-compose.production.yml up -d --build",
    "rc1:load": "node scripts/rc1-load-harness.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@patrol/license-core": "file:packages/license-core",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "better-sqlite3": "^12.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.11.6",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "typeorm": "^0.3.20",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.12",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    }
  },
  "windowsBuild": "2026.9.18.937"
}
